---
// "What would the cap allow?" Try different inflation and new-construction
// figures against the district's own preliminary estimate. Without JavaScript it
// shows the district's case (3% inflation): the numbers are server-rendered and
// the controls stay hidden. Typed number fields with −/+ buttons rather than
// sliders, which many people find hard to set precisely.
import { districtEstimate as d, cpiReadings } from '../data/figures';

const fmt = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const allowed = d.baseLevy * (d.assumedInflation / 100);
const gap = d.expected - allowed;
const pct = (v: number) => `${Math.min(100, (v / d.expected) * 100).toFixed(1)}%`;
---
<div class="calc" data-calc data-base={d.baseLevy} data-expected={d.expected}>
  <div class="calc-controls" data-calc-controls hidden>
    <div class="calc-field">
      <label for="calc-infl">Inflation <span class="muted">(Northeast prices, 12 months to March)</span></label>
      <div class="stepper">
        <button type="button" data-step="infl" data-delta="-0.1" aria-label="Lower inflation by 0.1 point">−</button>
        <input id="calc-infl" type="number" inputmode="decimal" min="0" max="10" step="0.1" value={d.assumedInflation.toFixed(1)} data-in="infl" />
        <span class="unit" aria-hidden="true">%</span>
        <button type="button" data-step="infl" data-delta="0.1" aria-label="Raise inflation by 0.1 point">+</button>
      </div>
      <div class="calc-presets" role="group" aria-label="Use a real inflation reading">
        {cpiReadings.map((r) => (
          <button type="button" data-preset={r.value} aria-pressed={r.value === d.assumedInflation ? 'true' : 'false'}>
            {r.label}: {r.value}%
          </button>
        ))}
      </div>
    </div>
    <div class="calc-field">
      <label for="calc-nc">New construction <span class="muted">(value added by new buildings)</span></label>
      <div class="stepper">
        <button type="button" data-step="nc" data-delta="-0.1" aria-label="Lower new construction by 0.1 point">−</button>
        <input id="calc-nc" type="number" inputmode="decimal" min="0" max="5" step="0.1" value="0.0" data-in="nc" />
        <span class="unit" aria-hidden="true">%</span>
        <button type="button" data-step="nc" data-delta="0.1" aria-label="Raise new construction by 0.1 point">+</button>
      </div>
    </div>
  </div>

  <div class="calc-result">
    <div class="calc-bars" aria-hidden="true">
      <div class="calc-bar">
        <span class="calc-bar-label">The cap would allow</span>
        <span class="calc-track"><span class="calc-fill allow" data-bar="allowed" style={`width:${pct(allowed)}`}></span></span>
        <span class="calc-bar-value" data-val="allowed">{fmt(allowed)}</span>
      </div>
      <div class="calc-bar">
        <span class="calc-bar-label">Expected cost increases</span>
        <span class="calc-track"><span class="calc-fill need" style="width:100%"></span></span>
        <span class="calc-bar-value">{fmt(d.expected)}</span>
      </div>
    </div>
    <p class="calc-verdict" data-verdict aria-hidden="true">
      <span class="calc-big" data-val="gap">{fmt(gap)}</span><span data-val="gap-label"> short in year one</span>
    </p>
    <p class="sr-only" data-summary role="status">
      At {d.assumedInflation}% inflation and no new construction, the cap would allow about {fmt(allowed)} more in school
      property taxes, against {fmt(d.expected)} in expected cost increases: about {fmt(gap)} short.
    </p>
  </div>
  <slot />
</div>
<script>
  import { initCalculators } from '../scripts/interactive';
  initCalculators();
</script>
