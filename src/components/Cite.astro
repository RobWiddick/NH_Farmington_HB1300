---
// Inline source link. Every factual claim on the site should be followed by
// one of these. Outside links always open in a new window with rel="nofollow".
import { sources, type SourceId } from '../data/sources';

interface Props {
  id: SourceId;
  /** Link text. Defaults to the source's short label. */
  label?: string;
  /** Deep link (page anchor, PDF page, video timestamp) for this one citation. */
  href?: string;
}

const { id, label, href } = Astro.props;
const src = sources[id];
if (!src) throw new Error(`Unknown source id "${id}" in <Cite>`);
const text = label ?? src.short;
---
<a
  class="cite"
  data-src={id}
  href={href ?? src.url}
  target="_blank"
  rel="nofollow noopener noreferrer"
  title={`${src.title} — ${src.publisher}${src.date ? `, ${src.date}` : ''}`}
>{text}<span class="sr-only"> (source, opens in a new window)</span><svg aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"><path d="M4.5 2H2v8h8V7.5M7 2h3v3M10 2 5.5 6.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
