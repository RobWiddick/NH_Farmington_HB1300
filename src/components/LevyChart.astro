---
// Year-by-year change in Farmington's school tax levy next to the inflation
// figure HB 1300 would have allowed. Plain HTML so it reads well on phones.
import { levyYearChanges } from '../data/figures';

const rows = levyYearChanges;
const min = Math.min(0, ...rows.map((r) => Math.min(r.change, r.cap)));
const max = Math.max(...rows.map((r) => Math.max(r.change, r.cap)));
const span = max - min;
const zero = ((0 - min) / span) * 100;
const pct = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}%`;
const bar = (v: number) => {
  const left = v >= 0 ? zero : zero - (Math.abs(v) / span) * 100;
  const width = Math.max(0.6, (Math.abs(v) / span) * 100);
  return `left:${left.toFixed(2)}%;width:${width.toFixed(2)}%`;
};
const over = (r: { over: boolean }) => r.over;
---
<figure class="levy-chart">
  <div class="legend" aria-hidden="true">
    <span>Farmington’s school tax levy, change from the year before</span>
    <span class="b">Inflation figure the cap would have allowed</span>
  </div>
  <ol class="levy-rows" role="list">
    {rows.map((r) => (
      <li class={over(r) ? 'is-over' : ''}>
        <span class="yr">{r.year}</span>
        <span class="tracks" aria-hidden="true">
          <span class="zero" style={`left:${zero.toFixed(2)}%`} />
          <span class="b1" style={bar(r.change)} />
          <span class="b2" style={bar(r.cap)} />
        </span>
        <span class="vals">
          <span class="sr-only">{r.year}: levy changed {pct(r.change)}; the cap’s inflation figure was {pct(r.cap)}{over(r) ? '; over the cap' : ''}.</span>
          <span aria-hidden="true"><b>{pct(r.change)}</b> vs {pct(r.cap)}</span>
          {over(r) && <span class="flag" aria-hidden="true">Over</span>}
        </span>
      </li>
    ))}
  </ol>
  <slot />
</figure>
<style>
  .levy-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .levy-rows li {
    display: grid;
    grid-template-columns: 2.9rem minmax(0, 1fr) 8.6rem;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .yr {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .tracks {
    position: relative;
    height: 1.7rem;
    background: var(--chart-track);
    border-radius: 6px;
  }
  .zero {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--muted);
  }
  .b1,
  .b2 {
    position: absolute;
    height: 0.62rem;
    border-radius: 3px;
  }
  .b1 {
    top: 0.16rem;
    background: var(--chart-a);
  }
  .is-over .b1 {
    background: var(--chart-c);
  }
  .b2 {
    bottom: 0.16rem;
    background: var(--chart-b);
  }
  .vals {
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.35rem;
  }
  .vals > span {
    white-space: nowrap;
  }
  .flag {
    font: 700 0.68rem/1 var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bad);
    border: 1.5px solid var(--bad);
    border-radius: 4px;
    padding: 0.18rem 0.3rem;
  }
  @media (max-width: 420px) {
    .levy-rows li {
      grid-template-columns: 2.6rem minmax(0, 1fr) 7.4rem;
      gap: 0.4rem;
      font-size: 0.85rem;
    }
  }
</style>
