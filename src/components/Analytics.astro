---
// Google Analytics 4. Loads gtag.js and the section/click tracking in
// src/scripts/analytics.ts. Nothing is sent from localhost. Cloudflare preview
// deployments send hits in debug mode so they show up in GA4 DebugView and can
// be excluded with the "Developer traffic" data filter.
import { site } from '../data/site';
const gaId = site.ga4Id;
---
{gaId && (
  <>
    <script is:inline define:vars={{ gaId }}>
      (function () {
        var host = location.hostname;
        if (host === 'localhost' || host === '127.0.0.1' || host === '::1') return;
        // <hash or branch>.<project>.pages.dev is a preview; <project>.pages.dev or a custom domain is live.
        var isPreview = /\.pages\.dev$/.test(host) && host.split('.').length > 3;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        var config = { allow_google_signals: false, allow_ad_personalization_signals: false };
        if (isPreview) config.debug_mode = true;
        window.gtag('config', gaId, config);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
        document.head.appendChild(s);
      })();
    </script>
    <script>
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
    </script>
  </>
)}
